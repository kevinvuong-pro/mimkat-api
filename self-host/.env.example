# Local Docker Compose can load this file with --env-file. Coolify should add
# these values as environment variables/secrets; no .env.production file is
# required by the Compose services.
POSTGRES_DB=mimkat
POSTGRES_USER=mimkat
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URL=postgresql://mimkat:replace-with-a-long-random-password@postgres:5432/mimkat?schema=public
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-other-random-characters

NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://app.example.com,https://admin.example.com

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=https://api.example.com/auth/google/callback

MAIL_PORT=587
MAIL_HOST=smtp.example.com
MAIL_FROM=noreply@example.com
MAIL_USER=replace-me
MAIL_PASSWORD=replace-me

AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ENDPOINT=https://s3.example.com

# Traefik/Cloudflare hostname. Do not include https://.
API_HOST=api.example.com

# Must match a resolver configured in the Traefik instance (usually letsencrypt).
TRAEFIK_CERTRESOLVER=letsencrypt
